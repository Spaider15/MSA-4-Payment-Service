<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_OrchestrPay" targetNamespace="http://orchestrpay.example/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <bpmn:collaboration id="Collaboration_OrchestrPay">
    <bpmn:participant id="Pool_Orchestrator" name="OrchestrPay — Payment Orchestrator (Camunda): обработка платежа на маркетплейсе" processRef="Process_Payment" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Payment" name="Обработка платежа" isExecutable="true">
    <bpmn:startEvent id="Start_Payment" name="Платёж инициирован">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_CreatePayment" name="CREATE_PAYMENT&#10;Создать платёж&#10;[Payment Service]" camunda:type="external" camunda:topic="create-payment">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_DebitFunds" name="DEBIT_CUSTOMER_FUNDS&#10;Списать средства клиента&#10;[Payment Service]" camunda:type="external" camunda:topic="debit-customer-funds">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Boundary_CreateComp" attachedToRef="Task_CreatePayment">
      <bpmn:compensateEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Boundary_DebitComp" attachedToRef="Task_DebitFunds">
      <bpmn:compensateEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Boundary_DebitError" name="Списание отклонено" attachedToRef="Task_DebitFunds" cancelActivity="true">
      <bpmn:outgoing>F37</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_DebitRejected" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_CancelPayment" name="CANCEL_PAYMENT&#10;Отменить платёж&#10;[Payment Service]" camunda:type="external" camunda:topic="cancel-payment" isForCompensation="true" />
    <bpmn:serviceTask id="Task_RefundFunds" name="REFUND_CUSTOMER_FUNDS&#10;Вернуть средства клиенту&#10;[Payment Service]" camunda:type="external" camunda:topic="refund-customer-funds" isForCompensation="true" />
    <bpmn:subProcess id="Sub_FraudCheck" name="Антифрод-проверки [FraudCheck Service]">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
      <bpmn:startEvent id="Fraud_Start">
        <bpmn:outgoing>F4</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:parallelGateway id="Fraud_Split">
        <bpmn:incoming>F4</bpmn:incoming>
        <bpmn:outgoing>F5</bpmn:outgoing>
        <bpmn:outgoing>F6</bpmn:outgoing>
        <bpmn:outgoing>F7</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:serviceTask id="Task_RulesCheck" name="FRAUD_RULES_CHECK&#10;Внутренние правила" camunda:type="external" camunda:topic="fraud-rules-check">
        <bpmn:incoming>F5</bpmn:incoming>
        <bpmn:outgoing>F8</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Task_AmlCheck" name="AML_CHECK&#10;Внешний AML-провайдер" camunda:type="external" camunda:topic="aml-check">
        <bpmn:incoming>F6</bpmn:incoming>
        <bpmn:outgoing>F9</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Task_GeoCheck" name="GEO_RISK_CHECK&#10;Внешний GeoRisk" camunda:type="external" camunda:topic="geo-risk-check">
        <bpmn:incoming>F7</bpmn:incoming>
        <bpmn:outgoing>F10</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:parallelGateway id="Fraud_Join">
        <bpmn:incoming>F8</bpmn:incoming>
        <bpmn:incoming>F9</bpmn:incoming>
        <bpmn:incoming>F10</bpmn:incoming>
        <bpmn:outgoing>F11</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:endEvent id="Fraud_End">
        <bpmn:incoming>F11</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="F4" sourceRef="Fraud_Start" targetRef="Fraud_Split" />
      <bpmn:sequenceFlow id="F5" sourceRef="Fraud_Split" targetRef="Task_RulesCheck" />
      <bpmn:sequenceFlow id="F6" sourceRef="Fraud_Split" targetRef="Task_AmlCheck" />
      <bpmn:sequenceFlow id="F7" sourceRef="Fraud_Split" targetRef="Task_GeoCheck" />
      <bpmn:sequenceFlow id="F8" sourceRef="Task_RulesCheck" targetRef="Fraud_Join" />
      <bpmn:sequenceFlow id="F9" sourceRef="Task_AmlCheck" targetRef="Fraud_Join" />
      <bpmn:sequenceFlow id="F10" sourceRef="Task_GeoCheck" targetRef="Fraud_Join" />
      <bpmn:sequenceFlow id="F11" sourceRef="Fraud_Join" targetRef="Fraud_End" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="Boundary_FraudCutOff" name="Cut-off проверок" attachedToRef="Sub_FraudCheck" cancelActivity="true">
      <bpmn:outgoing>F13</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${fraudCheckCutOff}</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_CutOffAllow1" name="Решение по умолчанию: ALLOW (cut-off)" camunda:type="external" camunda:topic="apply-cutoff-decision">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_DecisionMerge">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:incoming>F25</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_Decision" name="Решение антифрода?">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
      <bpmn:outgoing>F17</bpmn:outgoing>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ManualReview" name="REQUEST_MANUAL_REVIEW&#10;Направить на ручную проверку&#10;[FraudCheck Service]" camunda:type="external" camunda:topic="request-manual-review">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Boundary_ManualComp" attachedToRef="Task_ManualReview">
      <bpmn:compensateEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_CancelManual" name="CANCEL_MANUAL_REVIEW&#10;Отозвать задачу оператора" camunda:type="external" camunda:topic="cancel-manual-review" isForCompensation="true" />
    <bpmn:eventBasedGateway id="Gw_WaitOperator">
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Catch_OperatorDecision" name="Решение оператора получено">
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F23</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_OperatorDecision" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Catch_ManualTimeout" name="20 минут">
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:outgoing>F22</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT20M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_CutOffAllow2" name="Решение по умолчанию: ALLOW (cut-off)" camunda:type="external" camunda:topic="apply-cutoff-decision">
      <bpmn:incoming>F22</bpmn:incoming>
      <bpmn:outgoing>F24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_ManualMerge">
      <bpmn:incoming>F23</bpmn:incoming>
      <bpmn:incoming>F24</bpmn:incoming>
      <bpmn:outgoing>F25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Transfer" name="TRANSFER_TO_COUNTERPARTY&#10;Перевести контрагенту&#10;[Payment Service] — PIVOT" camunda:type="external" camunda:topic="transfer-to-counterparty">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F26</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Boundary_TransferError" name="Перевод отклонён" attachedToRef="Task_Transfer" cancelActivity="true">
      <bpmn:outgoing>F38</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_TransferRejected" />
    </bpmn:boundaryEvent>
    <bpmn:parallelGateway id="Gw_SuccessSplit">
      <bpmn:incoming>F26</bpmn:incoming>
      <bpmn:outgoing>F27</bpmn:outgoing>
      <bpmn:outgoing>F28</bpmn:outgoing>
      <bpmn:outgoing>F29</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_Complete" name="COMPLETE_PAYMENT&#10;Статус COMPLETED&#10;[Payment Service]" camunda:type="external" camunda:topic="complete-payment">
      <bpmn:incoming>F27</bpmn:incoming>
      <bpmn:outgoing>F30</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Accounting" name="RECORD_ACCOUNTING_ENTRY&#10;Проводка в учёт&#10;[Финансы]" camunda:type="external" camunda:topic="record-accounting-entry">
      <bpmn:incoming>F28</bpmn:incoming>
      <bpmn:outgoing>F31</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_NotifySuccess" name="NOTIFY_CUSTOMER_SUCCESS&#10;Уведомить клиента&#10;[Notification Service]" camunda:type="external" camunda:topic="notify-customer-success">
      <bpmn:incoming>F29</bpmn:incoming>
      <bpmn:outgoing>F32</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Gw_SuccessJoin">
      <bpmn:incoming>F30</bpmn:incoming>
      <bpmn:incoming>F31</bpmn:incoming>
      <bpmn:incoming>F32</bpmn:incoming>
      <bpmn:outgoing>F33</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="End_Completed" name="Платёж проведён">
      <bpmn:incoming>F33</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:parallelGateway id="Gw_DenySplit">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F34</bpmn:outgoing>
      <bpmn:outgoing>F36</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_NotifySecurity" name="NOTIFY_SECURITY_FRAUD_ALERT&#10;Уведомить службу безопасности" camunda:type="external" camunda:topic="notify-security">
      <bpmn:incoming>F34</bpmn:incoming>
      <bpmn:outgoing>F35</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_SecurityNotified" name="Безопасность уведомлена">
      <bpmn:incoming>F35</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gw_CompensationMerge">
      <bpmn:incoming>F36</bpmn:incoming>
      <bpmn:incoming>F37</bpmn:incoming>
      <bpmn:incoming>F38</bpmn:incoming>
      <bpmn:outgoing>F39</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="Throw_Compensate" name="Откатить выполненные шаги">
      <bpmn:incoming>F39</bpmn:incoming>
      <bpmn:outgoing>F40</bpmn:outgoing>
      <bpmn:compensateEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="Task_NotifyDeclined" name="NOTIFY_CUSTOMER_DECLINED&#10;Уведомить клиента об отказе&#10;[Notification Service]" camunda:type="external" camunda:topic="notify-customer-declined">
      <bpmn:incoming>F40</bpmn:incoming>
      <bpmn:outgoing>F41</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Declined" name="Отказ, средства возвращены">
      <bpmn:incoming>F41</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="Sub_CustomerCancel" name="Отмена клиентом (до перевода контрагенту)" triggeredByEvent="true">
      <bpmn:startEvent id="Cancel_Start" name="Клиент отменил платёж" isInterrupting="true">
        <bpmn:outgoing>F42</bpmn:outgoing>
        <bpmn:messageEventDefinition messageRef="Message_CustomerCancel" />
      </bpmn:startEvent>
      <bpmn:intermediateThrowEvent id="Cancel_Compensate" name="Откатить шаги">
        <bpmn:incoming>F42</bpmn:incoming>
        <bpmn:outgoing>F43</bpmn:outgoing>
        <bpmn:compensateEventDefinition />
      </bpmn:intermediateThrowEvent>
      <bpmn:serviceTask id="Task_NotifyCancelled" name="NOTIFY_CUSTOMER_DECLINED&#10;Уведомить клиента" camunda:type="external" camunda:topic="notify-customer-declined">
        <bpmn:incoming>F43</bpmn:incoming>
        <bpmn:outgoing>F44</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="Cancel_End" name="Платёж отменён">
        <bpmn:incoming>F44</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="F42" sourceRef="Cancel_Start" targetRef="Cancel_Compensate" />
      <bpmn:sequenceFlow id="F43" sourceRef="Cancel_Compensate" targetRef="Task_NotifyCancelled" />
      <bpmn:sequenceFlow id="F44" sourceRef="Task_NotifyCancelled" targetRef="Cancel_End" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="F1" sourceRef="Start_Payment" targetRef="Task_CreatePayment" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_CreatePayment" targetRef="Task_DebitFunds" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_DebitFunds" targetRef="Sub_FraudCheck" />
    <bpmn:sequenceFlow id="F12" sourceRef="Sub_FraudCheck" targetRef="Gw_DecisionMerge" />
    <bpmn:sequenceFlow id="F13" sourceRef="Boundary_FraudCutOff" targetRef="Task_CutOffAllow1" />
    <bpmn:sequenceFlow id="F14" sourceRef="Task_CutOffAllow1" targetRef="Gw_DecisionMerge" />
    <bpmn:sequenceFlow id="F15" sourceRef="Gw_DecisionMerge" targetRef="Gw_Decision" />
    <bpmn:sequenceFlow id="F16" name="Разрешено" sourceRef="Gw_Decision" targetRef="Task_Transfer">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decision == 'ALLOW'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F17" name="Ручная проверка" sourceRef="Gw_Decision" targetRef="Task_ManualReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decision == 'MANUAL_REVIEW'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F18" name="Запрет" sourceRef="Gw_Decision" targetRef="Gw_DenySplit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decision == 'DENY'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F19" sourceRef="Task_ManualReview" targetRef="Gw_WaitOperator" />
    <bpmn:sequenceFlow id="F20" sourceRef="Gw_WaitOperator" targetRef="Catch_OperatorDecision" />
    <bpmn:sequenceFlow id="F21" sourceRef="Gw_WaitOperator" targetRef="Catch_ManualTimeout" />
    <bpmn:sequenceFlow id="F22" sourceRef="Catch_ManualTimeout" targetRef="Task_CutOffAllow2" />
    <bpmn:sequenceFlow id="F23" sourceRef="Catch_OperatorDecision" targetRef="Gw_ManualMerge" />
    <bpmn:sequenceFlow id="F24" sourceRef="Task_CutOffAllow2" targetRef="Gw_ManualMerge" />
    <bpmn:sequenceFlow id="F25" name="Повторно оценить решение" sourceRef="Gw_ManualMerge" targetRef="Gw_DecisionMerge" />
    <bpmn:sequenceFlow id="F26" sourceRef="Task_Transfer" targetRef="Gw_SuccessSplit" />
    <bpmn:sequenceFlow id="F27" sourceRef="Gw_SuccessSplit" targetRef="Task_Complete" />
    <bpmn:sequenceFlow id="F28" sourceRef="Gw_SuccessSplit" targetRef="Task_Accounting" />
    <bpmn:sequenceFlow id="F29" sourceRef="Gw_SuccessSplit" targetRef="Task_NotifySuccess" />
    <bpmn:sequenceFlow id="F30" sourceRef="Task_Complete" targetRef="Gw_SuccessJoin" />
    <bpmn:sequenceFlow id="F31" sourceRef="Task_Accounting" targetRef="Gw_SuccessJoin" />
    <bpmn:sequenceFlow id="F32" sourceRef="Task_NotifySuccess" targetRef="Gw_SuccessJoin" />
    <bpmn:sequenceFlow id="F33" sourceRef="Gw_SuccessJoin" targetRef="End_Completed" />
    <bpmn:sequenceFlow id="F34" sourceRef="Gw_DenySplit" targetRef="Task_NotifySecurity" />
    <bpmn:sequenceFlow id="F35" sourceRef="Task_NotifySecurity" targetRef="End_SecurityNotified" />
    <bpmn:sequenceFlow id="F36" sourceRef="Gw_DenySplit" targetRef="Gw_CompensationMerge" />
    <bpmn:sequenceFlow id="F37" sourceRef="Boundary_DebitError" targetRef="Gw_CompensationMerge" />
    <bpmn:sequenceFlow id="F38" sourceRef="Boundary_TransferError" targetRef="Gw_CompensationMerge" />
    <bpmn:sequenceFlow id="F39" sourceRef="Gw_CompensationMerge" targetRef="Throw_Compensate" />
    <bpmn:sequenceFlow id="F40" sourceRef="Throw_Compensate" targetRef="Task_NotifyDeclined" />
    <bpmn:sequenceFlow id="F41" sourceRef="Task_NotifyDeclined" targetRef="End_Declined" />
    <bpmn:association id="A1" associationDirection="One" sourceRef="Boundary_CreateComp" targetRef="Task_CancelPayment" />
    <bpmn:association id="A2" associationDirection="One" sourceRef="Boundary_DebitComp" targetRef="Task_RefundFunds" />
    <bpmn:association id="A3" associationDirection="One" sourceRef="Boundary_ManualComp" targetRef="Task_CancelManual" />
    <bpmn:textAnnotation id="Note_Pivot">
      <bpmn:text>Pivot: после успешного перевода процесс идёт только вперёд, шаги ниже повторяемые</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_Pivot_Assoc" sourceRef="Note_Pivot" targetRef="Task_Transfer" />
    <bpmn:textAnnotation id="Note_Decision">
      <bpmn:text>Итоговое решение — самый строгий результат: DENY &gt; MANUAL_REVIEW &gt; ALLOW</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_Decision_Assoc" sourceRef="Note_Decision" targetRef="Sub_FraudCheck" />
    <bpmn:textAnnotation id="Note_Compensation">
      <bpmn:text>Компенсации (REFUND, CANCEL) повторяются до успеха, идемпотентны по paymentId</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_Compensation_Assoc" sourceRef="Note_Compensation" targetRef="Task_RefundFunds" />
  </bpmn:process>
  <bpmn:message id="Message_OperatorDecision" name="OperatorDecision" />
  <bpmn:message id="Message_CustomerCancel" name="CustomerCancel" />
  <bpmn:error id="Error_DebitRejected" name="DebitRejected" errorCode="DEBIT_REJECTED" />
  <bpmn:error id="Error_TransferRejected" name="TransferRejected" errorCode="TRANSFER_REJECTED" />
  <bpmndi:BPMNDiagram id="Diagram_OrchestrPay">
    <bpmndi:BPMNPlane id="Plane_OrchestrPay" bpmnElement="Collaboration_OrchestrPay">
      <bpmndi:BPMNShape id="Pool_di" bpmnElement="Pool_Orchestrator" isHorizontal="true">
        <dc:Bounds x="100" y="10" width="2440" height="990" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Payment_di" bpmnElement="Start_Payment">
        <dc:Bounds x="162" y="402" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="125" y="442" width="110" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CreatePayment_di" bpmnElement="Task_CreatePayment">
        <dc:Bounds x="250" y="380" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DebitFunds_di" bpmnElement="Task_DebitFunds">
        <dc:Bounds x="480" y="380" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_CreateComp_di" bpmnElement="Boundary_CreateComp">
        <dc:Bounds x="312" y="442" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_DebitComp_di" bpmnElement="Boundary_DebitComp">
        <dc:Bounds x="502" y="442" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_DebitError_di" bpmnElement="Boundary_DebitError">
        <dc:Bounds x="592" y="442" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="555" y="482" width="110" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CancelPayment_di" bpmnElement="Task_CancelPayment">
        <dc:Bounds x="255" y="560" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RefundFunds_di" bpmnElement="Task_RefundFunds">
        <dc:Bounds x="428" y="560" width="175" height="80" />
